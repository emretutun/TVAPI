{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "Broadage": {
    "ConnectTimeoutSeconds": 3,
    "CommandTimeoutSeconds": 5,
    "Cache": {
      "CompetitionSeconds": 30,
      "StandingsSeconds": 30,
      "MatchesSeconds": 5,
      "LineupsSeconds": 30,
      "TeamsSeconds": 300,
      "MaxStaleMinutes": 720
    }
  },
  "Channel": {
    "ConnectTimeoutSeconds": 3,
    "CommandTimeoutSeconds": 5,
    "Cache": {
      "SceneTemplatesSeconds": 60,
      "PlaylistsSeconds": 30,
      "SavedScenesSeconds": 5,
      "WeatherSeconds": 300
    }
  },
  "News": {
    "ConnectTimeoutSeconds": 3,
    "CommandTimeoutSeconds": 5,
    "Cache": {
      "RundownsSeconds": 30,
      "StoriesSeconds": 10,
      "StoryScenesSeconds": 5
    }
  },
  "AllowedHosts": "*"
}
